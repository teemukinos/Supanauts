SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Server only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SECRET
APP_ORIGIN=http://127.0.0.1:3017

# Optional separately licensed event photo source. Omit for the built-in illustration.
NEXT_PUBLIC_EVENT_MEDIA_BASE_URL=

# Canonical origin for metadata and calendars. Keep localhost during development.
PUBLIC_SITE_ORIGIN=http://127.0.0.1:3018
# Real transactional dispatch is deliberately disabled by default.
NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
# Server-side video processing requires these binaries on the upload host.
FFMPEG_PATH=
FFPROBE_PATH=
